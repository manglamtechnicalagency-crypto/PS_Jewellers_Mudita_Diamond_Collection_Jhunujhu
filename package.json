{
  "name": "ps-jewellers",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "//sideEffects": "Lets the bundler drop unused exports. HomePage and ProductCard import small helpers from src/data.ts; without this the whole ~46 KB seed catalogue rides along into the client bundle. CSS is listed so stylesheet imports are never dropped.",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ./tests/register.mjs tests/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "review:local": "npm run type-check && npm run test && npm run build",
    "verify": "npm run type-check && npm run test && npm run build",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "cloudflare": "^7.0.0",
    "next": "^16.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.22",
      "sharp": "^0.35.3"
    }
  }
}

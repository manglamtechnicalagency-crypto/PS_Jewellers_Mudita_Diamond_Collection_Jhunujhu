# Copy this file to .env (never commit .env — it's gitignored).
# Vars prefixed NEXT_PUBLIC_ are bundled into the CLIENT-SIDE JS and are PUBLIC.
# Vars without that prefix are available only to server-side code. Do not add
# NEXT_PUBLIC_ to a secret: that publishes it to every visitor's browser.

# --- Cloudflare R2 -----------------------------------------------------------
# Note: there is no shared-secret upload token. Media presigning lives at
# /api/admin/media/presign and is authorised by the Supabase session, MFA level,
# and admin role — the same gate as every other admin route.

# Cloudflare dashboard > R2 > Manage API tokens. These are server-only —
# the browser receives only a short-lived, single-object upload URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_QUARANTINE_BUCKET_NAME=
# Public bucket/CDN base URL for reading back uploaded files (safe to expose
# client-side once the bucket has a public read policy or custom domain).
NEXT_PUBLIC_R2_PUBLIC_URL=

# Optional Cloudflare D1 catalogue mirror. When all three are set, the public
# catalogue API reads from D1. The server-only API token must have D1 edit/read
# permission and is never bundled into the browser.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# --- Supabase ---------------------------------------------------------------
# Public URL/key may be exposed to browser code. In Next.js, public values
# need the NEXT_PUBLIC_ prefix to be available to Client Components.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key fallback; prefer the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key is server-only and must never use the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# Local testing only. Keep false/empty in every production environment.
ADMIN_MFA_BYPASS=
NEXT_PUBLIC_ADMIN_MFA_BYPASS=

# Optional upload API settings. Use a shared, provider-level limiter before
# enabling uploads across multiple server instances; the built-in fallback is
# process-local and cannot enforce a global limit.
R2_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
R2_UPLOAD_RATE_LIMIT_MAX_REQUESTS=30

# --- Public site URL (canonical URLs, sitemap, OpenGraph) ---
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost.
NEXT_PUBLIC_SITE_URL=

# Public showroom contact used by product enquiry WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=919829407255

# --- Durable upload rate limiting (recommended for any scaled deployment) ---
# Without these the limiter is per-instance: the effective ceiling becomes
# max x instances and every cold start resets the window.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "true" ONLY on a platform that provides no trusted client-IP header.
# The presign route otherwise fails closed rather than sharing one bucket.
R2_UPLOAD_RATE_LIMIT_TRUST_UNIDENTIFIED=

# --- Live metal market rates (admin dashboard, read-only) --------------------
# Reference data only. This feed NEVER writes to the metal_rates table; product
# pricing still uses the rates an admin sets in /admin/catalogue.
# See docs/admin/MARKET_RATES.md for setup and troubleshooting.
#
# NO API KEY REQUIRED. Both upstreams are free and keyless:
#   metal spot  https://api.gold-api.com/price/XAU  (and /XAG), USD per troy ounce
#   USD -> INR  https://open.er-api.com/v6/latest/USD
# Everything below is optional; the defaults work with no configuration at all.

# "live" | "mock" | "off". Unset means live in every environment. Use "mock"
# only for offline work — it serves fixed sample numbers, not market data.
METAL_MARKET_RATES_MODE=

# Override only if you are pointing at a proxy or a stub server.
METALS_API_URL=https://api.gold-api.com/price
FX_API_URL=https://open.er-api.com/v6/latest/USD

# Cache TTL. Clamped to 300-900 seconds regardless of what you put here.
METAL_MARKET_RATES_CACHE_SECONDS=600

# --- Accuracy knobs. These decide whether the dashboard matches other brokers.
#
# Validated 30 Jul 2026 against published Indian rates (GoodReturns /
# goldpriceindia): gold 24K within 0.06%, silver 999 within 0.08%.
#
# Import duty on gold AND silver. 10% BCD + 5% AIDC = 15%, in force since
# 13 May 2026 (it was 6% before that). THIS IS A POLICY NUMBER AND IT MOVES —
# a stale value here shifts every rate on the dashboard by the same percent.
# Re-check it at every Union Budget.
METAL_RATES_IMPORT_DUTY_PERCENT=15

# Left at 0 on purpose. IBJA, GoodReturns, Tanishq and the broker apps all
# publish gold and silver EX-GST; the 3% is added at the counter. Setting this
# to 3 puts the widget ~3% above every source you would compare against.
METAL_RATES_GST_PERCENT=0

# Local basis over international spot, per metal. Silver's is structurally
# wider than gold's in the Indian physical market. Calibrate against your own
# sarafa board — see the Calibration section in docs/admin/MARKET_RATES.md.
METAL_RATES_GOLD_PREMIUM_PERCENT=0
METAL_RATES_SILVER_PREMIUM_PERCENT=2

METAL_RATES_REGION_LABEL=Jhunjhunu, Rajasthan
